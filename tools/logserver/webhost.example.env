# Where the reference log server runs. Copy to webhost.local.env (git-ignored)
# and fill in. Nothing committed names the web host; this file is the only place
# its real details belong, and only in the .local copy.
#
#   source tools/logserver/webhost.local.env

WEBHOST_NAME="webhost.example.net"     # the VM's own DNS name
WEBHOST_RG="RG-EXAMPLE"                # Azure resource group, for `az ssh config`
WEBHOST_VM="webhost"                   # Azure VM name
WEBHOST_SSH="RG-EXAMPLE-webhost"       # the alias `az ssh config` writes
WEBHOST_COMPOSE_DIR="/home/youruser/webhost"   # docker compose dir holding Caddy

# Extended regex of names that must never reach a tracked file: the host, its
# login, its other sites. Used by the leak check in caddy/README.md.
WEBHOST_PRIVATE_PATTERN="webhost\.example\.net|youruser|RG-EXAMPLE"
